# ---------- 运行环境 ----------
NODE_ENV=development
PORT=8080
API_PREFIX=api

# ---------- 数据库（业务库） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123456
DB_NAME=env_mon
DB_LOGGING=false
# synchronize 仅用于本地开发，生产必须关闭并走迁移
DB_SYNCHRONIZE=true

# ---------- Redis（会话 / 幂等 / 缓存） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 认证 ----------
JWT_SECRET=change-me-in-production-please-use-32bytes
JWT_EXPIRES_IN=8h

# ---------- HJ212 接入 ----------
# 数据源模式：direct = 自建 TCP 直连数采仪；upstream = 对接国发/省平台
INGEST_MODE=direct
HJ212_TCP_PORT=20000
HJ212_HTTP_ENABLED=true
# 应答模式：qnrtn（CP 中回 QnRtn）| exerntn（CP 中回 ExeRtn）
HJ212_ACK_MODE=qnrtn
# 未注册 MN 是否拒绝
HJ212_REJECT_UNKNOWN_MN=true

# ---------- 消息渠道 ----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=
WX_MP_APP_ID=
WX_MP_APP_SECRET=
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=
